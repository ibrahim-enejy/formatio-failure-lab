# syntax=docker/dockerfile:1
# Reference pattern for consuming build-only Formatio Secrets without baking them into image layers.
FROM node:20-alpine AS builder
WORKDIR /app

COPY apps/node-express/package.json apps/node-express/package-lock.json ./

# Add PACKAGE_TOKEN on Formatio Environment tab as a Secret (never Variable).
# It mounts ephemerally at /run/secrets/PACKAGE_TOKEN during this RUN instruction only.
RUN --mount=type=secret,id=PACKAGE_TOKEN,required=false \
  sh -c 'if [ -s /run/secrets/PACKAGE_TOKEN ]; then echo "Authenticated private registry step with ephemeral BuildKit secret"; fi && npm ci'
