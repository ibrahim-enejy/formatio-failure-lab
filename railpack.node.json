{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "inputs": [
        { "step": "packages:mise" },
        {
          "local": true,
          "include": ["apps/node-express"],
          "exclude": ["apps/node-express/node_modules"]
        }
      ],
      "commands": [
        "cd apps/node-express && npm ci --omit=dev"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["libatomic1"],
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      {
        "step": "build",
        "include": ["/app/apps/node-express"]
      }
    ],
    "startCommand": "cd /app/apps/node-express && exec node --require @opentelemetry/auto-instrumentations-node/register app.js",
    "variables": {
      "NODE_ENV": "production",
      "DATA_DIR": "/data",
      "OTEL_METRICS_EXPORTER": "none",
      "OTEL_LOGS_EXPORTER": "none",
      "OTEL_NODE_RESOURCE_DETECTORS": "env,host,os,process,serviceinstance,container"
    }
  }
}
